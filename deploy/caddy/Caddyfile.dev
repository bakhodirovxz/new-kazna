{
	admin off
}

# Xavfsizlik sarlavhalari: oddiy javoblar va handle_errors (Caddy'ning o'z xatolari) uchun umumiy.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
		-Via
	}
}

# "caddy" — ichki tarmoqdagi E2E konteyneri uchun (https://caddy).
localhost, caddy {
	tls internal
	# S5: AI-анализ javobi — SSE oqimi; siqish uni buferlaydi, shuning uchun istisno.
	@compress not path /api/v1/ai/analyze
	encode @compress zstd gzip

	request_body {
		max_size 1MB
	}

	import security_headers

	# '//evil.com/' kabi yo'llar SPA'ning location.pathname asosidagi navigatsiyasini
	# cross-origin URL'ga aylantirishi mumkin — bosh slash'lar ko'p bo'lsa '/' ga yo'naltiramiz.
	@dupslash expression {http.request.uri.path}.startsWith('//')
	redir @dupslash / 308

	# Force-browsing (Kiberxavfsizlik markazi 05-29-02/5323): nuqta bilan boshlanuvchi har qanday
	# segment (.git, .env, .DS_Store ...) — 404, SPA fallback'dan oldin. /.well-known/<nom> istisno.
	@dotseg {
		# orig_uri: Caddy yo'lni tozalashdan OLDINGI holat (/%2e%2e/ ham tutiladi). Teskari slash (\, %5c) — taqiq.
		expression {http.request.orig_uri.path}.matches('(?i)(^|/)([.]|%2e)') || {http.request.orig_uri.path}.matches('\\x5c')
		# Faqat bitta darajali /.well-known/<nom> (nuqtasiz) istisno.
		not expression {http.request.orig_uri.path}.matches('^/[.]well-known/[^/.][^/]*$')
	}
	handle @dotseg {
		error 404
	}

	# Probe'lar faqat ichki tarmoq uchun. `handle`lar birinchi mos kelgan direktivada
	# to'xtaydi (Caddy'da tartib muhim) — shu sabab bu blok `handle /api/*`dan OLDIN va
	# o'zi ham `handle @probes { ... }` ichida bo'lishi kerak (yalang'och `respond @probes 404`
	# keyingi `handle /api/*`ga to'g'ri "yutqazib" bermaydi, chunki `respond` mustaqil
	# direktiva sifatida ham ishlaydi va navbatdagi `handle /api/*` baribir keyin chaqiriladi
	# hamda healthz/readyz'ni tashqariga ochib qo'yadi).
	@probes path /api/v1/healthz /api/v1/readyz
	handle @probes {
		respond 404
	}

	handle /api/v1/ai/analyze {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# Frontend: frontend/Dockerfile `web` bosqichi -> /srv. Hash-routing, HTML faqat "/".
	handle {
		root * /srv

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"

		# SPA fallback: /assets/ dan tashqari yo'q yo'l -> index.html; yo'q asset -> 404.
		# Kengaytmali yo'l (/package.json, /src/main.tsx) yo'q bo'lsa — 404, index.html emas.
		@spa {
			not path /assets/*
			not path_regexp \.[^/]+$
			file {
				try_files {path} /index.html
			}
		}
		rewrite @spa {file_match.relative}

		file_server
	}

	# Caddy'ning o'zi hosil qilgan xatolar (404 asset, 502 api, 413) ham sarlavhalarni oladi
	# va immutable keshni bekor qiladi.
	handle_errors {
		import security_headers
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
