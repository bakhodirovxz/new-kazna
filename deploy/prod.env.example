# Prod o'zgaruvchilari. Nusxa: /opt/ugekazna/shared/prod.env (git'ga tushmaydi), reliz papkasida
# deploy/prod.env → shu faylga symlink. Batafsil: docs/ops/install-upgrade.md.
# UGK_VERSION bu yerda emas — reliz paketidagi deploy/release.env da.

# Tizim manzili (korporativ sertifikatdagi DNS nomi bilan bir xil)
UGK_DOMAIN=ugekazna.uge.local
# Portlar qaysi interfeysda ochiladi (VPN tomonidagi IP; 0.0.0.0 — hammasi, ufw/DOCKER-USER cheklaydi)
UGK_BIND_ADDR=0.0.0.0
UGK_HTTPS_PORT=443
UGK_HTTP_PORT=80
# caddy ↔ api ichki tarmog'i; api X-Forwarded-For'ga faqat shu subnetdan ishonadi. Server LAN/boshqa
# Docker tarmog'i bilan to'qnashsa almashtiring.
UGK_WEB_SUBNET=172.31.250.0/24
# Caddy oldida reverse proxy bo'lsa (aaPanel Apache → 127.0.0.1:UGK_HTTPS_PORT): Docker gateway
# manzillari (edge va web tarmoqlari, `docker network inspect`), aks holda shu standart qiymat.
UGK_TRUSTED_PROXIES=127.0.0.1/32

# PostgreSQL profili: 8gb | 16gb (ci — faqat sinov). 16gb uchun: UGK_DB_MEM=9g, UGK_DB_CPUS=4
UGK_PG_PROFILE=8gb
UGK_DB_MEM=4g
UGK_DB_CPUS=2

# Sirlar papkasi (scripts/secrets_perms.sh bilan himoyalangan)
UGK_SECRETS_DIR=/opt/ugekazna/shared/secrets
# Zaxira repozitoriysi — alohida disk ustidagi external volume (docs/ops/backup-restore.md)
UGK_BACKUP_VOLUME=ugk_pgbackrest_repo
# Birinchi ishga tushishda darhol to'liq zaxira (yes|no)
UGK_BACKUP_INITIAL_FULL=yes

# Ichki SMTP relay (ETL va ops-check xabarnomalari). Bo'sh — faqat loglarga.
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=ugekazna@uge.uz
SMTP_TO=
SMTP_USER=
# STARTTLS (587/25) yoki implicit TLS (465). Parol faqat shifrlangan kanal bilan yuboriladi (Settings.problems()).
SMTP_STARTTLS=true
SMTP_SSL=false

# AI-анализ (faqat deploy/compose.ai.yml bilan, ИБ roziligidan keyin). Kalit, model, effort va
# limitlar — admin panelda (Интеграции / Политика безопасности); bu yerda faqat tarmoq.
# Bo'sh — SDK standarti (https://api.anthropic.com). Faqat https.
AI_BASE_URL=
# Korporativ proksi (api.anthropic.com:443 ruxsat etilgan); bo'sh — to'g'ridan-to'g'ri.
EGRESS_PROXY=
